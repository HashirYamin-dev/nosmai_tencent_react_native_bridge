    "ios",
    "react-native-nosmai-tencent-bridge.podspec",
    "README.md",
    "docs"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19.1.0",
    "react-native": ">=0.81.5",
    "@nosmai/react-native-effects-sdk": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/react": "^19.1.0",
    "react-native": "0.81.5",
    "react": "19.1.0",
    "@nosmai/react-native-effects-sdk": "2.0.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "node bin/nosmai-tencent-doctor.js"
  },
  "private": true,
  "codegenConfig": {
    "name": "NTBVideoViewSpec",
